{
  "name": "enterprise-kb",
  "version": "1.2.0",
  "description": "Enterprise knowledge base with OpenAI-compatible LLM support, multi-user auth, and document management",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npx tsx src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run test && npm audit --omit=dev --audit-level=moderate",
    "codex:smoke": "node scripts/codex-smoke.mjs",
    "smoke:full": "node scripts/full-smoke.mjs",
    "bench:search": "node scripts/bench-search.mjs",
    "upgrade:check": "node scripts/upgrade-check.mjs",
    "backup": "node dist/backup-cli.js backup",
    "backup:list": "node dist/backup-cli.js list",
    "restore": "node dist/backup-cli.js restore"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "claude-tools-kit": "file:packages/claude-tools-kit",
    "cors": "^2.8.5",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "multer": "^2.5.0",
    "officeparser": "^8.1.0",
    "openai": "^7.41.0",
    "p5": "^2.3.4",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "mammoth": {
      "argparse": "^2.0.1"
    }
  }
}
