# 大模型配置（任何兼容 OpenAI 接口的服务商都可以）
# MiniMax：
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=replace-with-your-provider-api-key
LLM_MODEL=MiniMax-M3
# Ollama 示例：
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# 每次回答最多调用几轮工具
LLM_MAX_TURNS=8

# 语义向量检索（可选；EMBEDDING_MODEL 留空则不启用）
# 不单独设置时，使用上面的 LLM_BASE_URL / LLM_API_KEY。
# 示例：text-embedding-3-small（OpenAI）、nomic-embed-text（Ollama）、embo-01（MiniMax）
EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=https://api.minimaxi.com/v1
# EMBEDDING_API_KEY=

# 发给模型的历史对话上限（最近多少条消息、多少字符）
HISTORY_MAX_MESSAGES=40
HISTORY_MAX_CHARS=40000

# 本地文件夹同步的安全上限
SYNC_MAX_FILES=1000
SYNC_MAX_TOTAL_MB=500
# 只有管理员能设置知识库的同步文件夹。可以进一步限制同步文件夹必须位于下面这些目录里
# （用逗号分隔，生产环境建议设置），例如 /srv/shared-docs
SYNC_ALLOWED_ROOTS=

# PDF / Office 的文字提取在单独的线程里进行；单个文件超过这个秒数就放弃
EXTRACT_TIMEOUT_SECONDS=120

# 扫描版 PDF 和上传的照片（JPG/PNG 等）用内置 OCR 识别（中文 + 英文）。
# 在本服务器上离线运行。设为 OCR_ENABLED=false 可以关闭。
OCR_ENABLED=true
# 每个 PDF 最多识别多少页扫描页（每页约 1–2 秒）
OCR_MAX_PAGES=100

# 安全
# 生产环境必须改成至少 32 个字符的随机字符串。
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-chars
JWT_EXPIRES_IN=24h

# 服务器
PORT=8080
# 允许跨域访问的来源，用逗号分隔。界面和接口由同一个服务器提供时留空。
CORS_ORIGIN=
# 部署在可信的反向代理后面时设为 true 或 1。
TRUST_PROXY=false
# 访问大模型 / 向量接口时使用的出站 HTTP 代理（可选）。
# NO_PROXY 里的地址（例如本机的 Ollama）直接连接，不走代理。
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1

# 初始管理员账号。部署到生产环境前必须修改 ADMIN_PASSWORD。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# 存储位置
STORAGE_PATH=./storage
DB_PATH=./data/enterprise-kb.db

# 登录频率限制（可选）：时间窗口（毫秒）和窗口内最多尝试次数
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10

# 备份。相对路径按项目根目录解析。
BACKUP_DIR=backups
BACKUP_KEEP=7
# 服务器运行期间每隔多少小时自动备份一次（0 表示关闭）。管理员也可以在
# 管理控制台 → 设置 里手动备份。每份备份都包含全部文档的完整副本。
BACKUP_INTERVAL_HOURS=24
