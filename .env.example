# LLM configuration (any OpenAI-compatible provider)
# MiniMax:
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=replace-with-your-provider-api-key
LLM_MODEL=MiniMax-M3
# Ollama example:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Maximum tool-calling turns per answer
LLM_MAX_TURNS=8

# Semantic vector search (optional — leave EMBEDDING_MODEL empty to disable)
# Uses the same LLM_BASE_URL / LLM_API_KEY if not overridden.
# Examples: text-embedding-3-small (OpenAI), nomic-embed-text (Ollama), embo-01 (MiniMax)
EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=https://api.minimaxi.com/v1
# EMBEDDING_API_KEY=


# Recent persisted conversation context sent to the model
HISTORY_MAX_MESSAGES=40
HISTORY_MAX_CHARS=40000

# Local folder sync safety limits
SYNC_MAX_FILES=1000
SYNC_MAX_TOTAL_MB=500

# Security
# Production must use a random value with at least 32 characters.
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-chars
JWT_EXPIRES_IN=24h

# Server
PORT=8080
# Comma-separated allowed origins. Leave empty when serving the UI from this same server.
CORS_ORIGIN=
# Set to true/1 when running behind a trusted reverse proxy.
TRUST_PROXY=false

# Initial admin account. Change ADMIN_PASSWORD before production deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Storage
STORAGE_PATH=./storage
DB_PATH=./data/enterprise-kb.db

# Optional login rate limits
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10
